CLOUDFLARE_ACCOUNT_ID=
# Scoped ONLY for Cache Purge on sovereignsanctuary.net (do not use Worker/R2/D1 token here).
# Dashboard example name: "Sovereign Deploy Cache Purge" — Zone · Cache Purge · Purge · Specific zone · sovereignsanctuary.net
# After Flutter web deploy: bash scripts/cf_purge_flutter_web.sh
CLOUDFLARE_PURGE_TOKEN=

# -----------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (signup.html TRIAL_FREE registration + try.html anon trial)
# -----------------------------------------------------------------------------
# Site key is public — embedded in both dashboard/signup.html and dashboard/try.html
# (same Managed widget, appearance:'interaction-only' on try.html keeps it invisible
# to real visitors). Secret is server-only — used by backend/app/services/turnstile.py
# for siteverify, called from both the signup flow and public_trial_gate.py.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# PUBLIC TRIAL FUNNEL (dashboard/try.html — anonymous, unauthenticated chat trial)
# -----------------------------------------------------------------------------
# Master switch. All public_trial_* WebSocket handlers are no-ops when false.
PUBLIC_TRIAL_ENABLED=false
# Shared global daily turn budget across ALL anonymous trial visitors combined.
MAX_TRIAL_TURNS_PER_DAY=2000
# 2026-07 bot-abuse hardening: per-HOUR ceiling on the same shared budget so a
# scripted burst can drain at most ~1 hour's slice instead of the whole day in
# minutes. Defaults to max(50, MAX_TRIAL_TURNS_PER_DAY // 3) if unset.
MAX_TRIAL_TURNS_PER_HOUR=
# 2026-07 bot-abuse hardening: requires a verified Cloudflare Turnstile token
# before public_trial_start creates a trial row, and re-checks a sliding
# "device verified" window before every public_trial_chat turn. Defaults ON
# (fail-closed) — if TURNSTILE_SECRET_KEY above isn't set, the trial simply
# never starts rather than silently allowing unmetered scripted inference.
PUBLIC_TRIAL_TURNSTILE_ENABLED=true
