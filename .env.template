# SKYEYE — Token Encryption (REQUIRED for production)
# Encrypts OAuth tokens at rest in the database using Fernet symmetric encryption.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
SKYEYE_TOKEN_ENCRYPTION_KEY=

# Persistent audit token — gives automated trust auditors a guaranteed admin
# bearer token without requiring an active admin login session.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Registered in Redis on backend startup with a 365-day TTL.
SKYEYE_AUDIT_TOKEN=

