# -----------------------------------------------------------------------------
# NETWORK CONFIGURATION
# -----------------------------------------------------------------------------
SERVER_HOST=10.0.0.81
SERVER_PORT=8000
WEBSOCKET_PORT=8765
ADMIN_PORT=3000

# Production domain (when you have one)
# DOMAIN=littlenate.ai
# For now, we use IP
BASE_URL=http://10.0.0.81:8000
WS_URL=ws://10.0.0.81:8765

# -----------------------------------------------------------------------------
# AZURE OPENAI (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from Azure Portal > Your OpenAI Resource > Keys and Endpoint
AZURE_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-realtime-preview
AZURE_OPENAI_MINI_TTS_DEPLOYMENT=gpt-4o-mini-tts

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Local development
POSTGRES_HOST=10.0.0.81
POSTGRES_PORT=5432
POSTGRES_DB=little_nate
POSTGRES_USER=nate_admin
POSTGRES_PASSWORD=your_secure_password_here

# Full connection string (auto-generated from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# REDIS (Session Cache)
# -----------------------------------------------------------------------------
REDIS_HOST=10.0.0.81
