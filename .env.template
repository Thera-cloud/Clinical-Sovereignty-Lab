# scripted burst can drain at most ~1 hour's slice instead of the whole day in
# minutes. Defaults to max(50, MAX_TRIAL_TURNS_PER_DAY // 3) if unset.
MAX_TRIAL_TURNS_PER_HOUR=
# 2026-07 bot-abuse hardening: requires a verified Cloudflare Turnstile token
# before public_trial_start creates a trial row, and re-checks a sliding
# "device verified" window before every public_trial_chat turn. Defaults ON
# (fail-closed) — if TURNSTILE_SECRET_KEY above isn't set, the trial simply
# never starts rather than silently allowing unmetered scripted inference.
PUBLIC_TRIAL_TURNSTILE_ENABLED=true

