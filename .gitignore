# -----------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.swp

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
postgres_data/
redis_data/
gmail_tokens_output.json

# Scripts with hardcoded OAuth secrets
scripts/get_gmail_tokens.py
scripts/get_outlook_tokens.py
scripts/reauth_nathan.py

# WireGuard secrets
wireguard/*/privatekey

# Mobile development backup files
mobile/lib/*.backup*
mobile/lib/**/*.backup*
backend/resources/therapeutic_library/imagery_guides/.wrangler/
deploy-web.sh

# Local agent heartbeat (machine-specific)
data/mac_agent_alive.json
# Runtime SSE / bridge fallback log — unbounded growth, not source of truth
data/blue_fallback.jsonl

# Block bypass patterns in any directory under dashboard/ and mobile/
dashboard/**/admin_bypass*
dashboard/**/*bypass*.html
dashboard/**/*_bypass.html
mobile/**/admin_bypass*
mobile/**/*bypass*.html

# Block dev/test HTML in any dashboard/mobile location (local tools only; must not ship)
dashboard/**/check_session*
dashboard/**/debug.html
dashboard/**/test_*.html
dashboard/**/ws_test*
dashboard/**/Untitled
mobile/**/check_session*
mobile/**/debug.html
mobile/**/test_*.html
mobile/**/ws_test*
mobile/**/Untitled
.cursorrules.archive.*

# Defensive: never let git clean track vault dirs — stub file stays tracked for emptiable dirs
/data/**
!/data/.gitkeep
