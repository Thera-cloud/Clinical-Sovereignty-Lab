# Copy to `.env` and fill in secrets. Used by docker-compose.prod.yml (GREEN / nate_backend).
# See `.cursor/rules/three-node-sync-discipline.mdc` for ORANGE (voice) / BLUE (visual) routing.

# --- Three-node classroom video / distributed inference (GREEN orchestrator) ---
# ORANGE (Hetzner, WireGuard): wav2vec2 voice emotion — set on GREEN so HTTP dispatch works.
CLASSROOM_VOICE_REMOTE_URL=http://10.13.13.5:8090
# BLUE (Mac tunnel): optional visual frames; leave empty to use GREEN CPU sampling.
CLASSROOM_VISUAL_REMOTE_URL=
# Shared bearer for POST /voice-emotion and POST /classroom/visual on ORANGE/BLUE.
# Generate once: openssl rand -hex 32 — same value on GREEN, ORANGE env, and BLUE.
CLASSROOM_REMOTE_AUTH_TOKEN=
# Per-call HTTP timeout to ORANGE/BLUE (seconds). Long classroom videos need 1800+.
CLASSROOM_REMOTE_TIMEOUT_SEC=1800

# GREEN-only: when 1, VoiceEmotionAnalyzer never loads wav2vec2 in this container (librosa rules
# only). Must stay 1 on GREEN so ORANGE timeouts do not OOM the 6G FastAPI container.
# ORANGE sets VOICE_EMOTION_FORCE_LIBROSA=0 in voice_emotion_server._get_analyzer().
VOICE_EMOTION_FORCE_LIBROSA=1
