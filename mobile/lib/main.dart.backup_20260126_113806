class LobbyScreen extends StatefulWidget {
  const LobbyScreen({super.key});

  @override
  _LobbyScreenState createState() => _LobbyScreenState();
}

class _LobbyScreenState extends State<LobbyScreen> {
  final HardwareIdentity _identity = HardwareIdentity();
  WebSocketChannel? _channel;
  
  // Connection State
  bool _isConnected = false;
  String _statusMessage = "Initializing...";
  bool _isLoading = false;

  // Credentials for Handoff
  String _tempUser = "";
  String _tempPass = "";
  
  // Hardcoded IP (Make sure this matches your Mac!)
  final String _serverUrl = 'ws://10.0.0.81:8765';

  @override
  void initState() {
    super.initState();
    _connectToBridge();
  }

  void _connectToBridge() {
    setState(() {
      _statusMessage = "Connecting to $_serverUrl...";
      _isConnected = false;
    });

    try {
      _channel = WebSocketChannel.connect(Uri.parse(_serverUrl));
      
      _channel!.stream.listen(
        _handlePacket, 
        onError: (e) {
          print("Lobby Socket Error: $e");
          if (mounted) setState(() {
            _isConnected = false;
            _statusMessage = "Connection Failed. Server Offline?";
          });
        },
        onDone: () {
          print("Lobby Socket Closed");
          if (mounted) setState(() {
            _isConnected = false;
            _statusMessage = "Disconnected.";
          });
        }
      );
      
      // If we didn't crash immediately, assume we are good (Socket doesn't confirm until message)
      // We will send a "ping" to verify connection
      Future.delayed(const Duration(milliseconds: 500), () {
        if (mounted) setState(() {
          _isConnected = true;
          _statusMessage = "SECURE LINK ESTABLISHED";
        });
      });

    } catch (e) {
      if (mounted) setState(() => _statusMessage = "Fatal Connection Error: $e");
    }
  }

  void _handlePacket(dynamic message) {
    // If we receive ANYTHING, we are definitely connected
    if (!_isConnected) setState(() => _isConnected = true);

    try {
      final data = jsonDecode(message);
      print("Lobby Received: $data");

      if (data['type'] == 'login_success') {
        setState(() => _isLoading = false);
        
        // --- THE HANDOFF (Prevent Stream Crash) ---
        Map<String, dynamic> profile = data['profile'];
        String role = profile['role'] ?? "CLIENT";
        
        // 1. Close the Lobby Line
        _channel?.sink.close();
        
        // 2. Open the Session Line
        final sessionSocket = WebSocketChannel.connect(Uri.parse(_serverUrl));
        
        // 3. Blind Login
        sessionSocket.sink.add(jsonEncode({
          "type": "login_request",
          "username": _tempUser,
          "password": _tempPass,
          "expected_role": role
        }));

        // 4. Navigate
        Widget nextScreen;
        if (role == 'ADMIN') {
          nextScreen = AdminDashboardScreen(currentUserProfile: profile, username: _tempUser, password: _tempPass);
        } else if (role == 'COACH') {
          nextScreen = CoachDashboardScreenV2(currentUserProfile: profile, username: _tempUser, password: _tempPass);
        } else {
          nextScreen = NeuralInterfaceV2(currentUserProfile: profile, username: _tempUser, password: _tempPass);
        }

        Navigator.pushReplacement(context, MaterialPageRoute(builder: (_) => nextScreen));
        
      } else if (data['type'] == 'login_failed') {
        Navigator.pop(context); // Close dialog if open
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(
          content: Text("ACCESS DENIED: ${data['message']}"),
          backgroundColor: Colors.red,
        ));
        setState(() => _isLoading = false);
      }
    } catch (e) {
      print("Parse Error: $e");
    }
  }

  void _showLoginDialog(String expectedRole) {
    if (!_isConnected) {
      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text("Cannot Login: Offline")));
      return;
    }

    TextEditingController userCtrl = TextEditingController();
    TextEditingController passCtrl = TextEditingController();
    
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: const Color(0xFF111111),
