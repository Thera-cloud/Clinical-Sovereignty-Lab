                        "family_id": family_id,
                        "members": members
                    }))
            
            # === NEVEDAL: BIOMETRIC UPDATE ===
            elif t == "biometric_update":
                if current_profile:
                    await nevedal_handler.handle_biometric_update(websocket, d, current_profile)
            
            # === NEVEDAL: SUBSCRIBE ===
            elif t == "nevedal_subscribe":
