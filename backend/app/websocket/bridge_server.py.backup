                            "mood_history": metrics.get("nevedal_state", {}).get("mood_history", []),
                            "recent_conversations": recent_memory[-5:],
                            "family_id": client_profile.get("family_id")
                        }
                        
                        await websocket.send(json.dumps({"type": "presession_brief", "brief": brief}))
            
            # === COACH: GET CALENDAR ===
