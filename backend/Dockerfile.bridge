# =============================================================================
# LITTLE NATE — WebSocket Bridge Server
# =============================================================================
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app/ ./app/

# Create directories with proper permissions
RUN mkdir -p /app/logs /app/data/Vaults/Admin /app/data/Vaults/Coaches /app/data/Vaults/Clients /app/data/Vaults/Guests

# Create non-root user and set ownership
RUN useradd -m -u 1000 nate && chown -R nate:nate /app

USER nate

# Expose WebSocket port
EXPOSE 8765

# Start bridge server
CMD ["python", "-m", "app.websocket.bridge_server"]