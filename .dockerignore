# =============================================================================
# LITTLE NATE — Docker Ignore
# =============================================================================

# Version control
.git
.gitignore

# IDE
.cursor
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
dist
build
.pytest_cache
.mypy_cache
htmlcov
.coverage

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Docs / Plans / Backups
docs/
*.md
*.backup
*.backup_*
*.plan.md

# Data (mounted as volumes, not baked into image)
data/
logs/
*.log

# Mobile (not needed for backend/admin containers)
mobile/

# SSL certs (mounted separately)
nginx/ssl/
